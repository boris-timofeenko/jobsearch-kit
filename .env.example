# Секреты. Файл .env не попадает в git. Нужны только первые два блока, остальное — по желанию.

# Telegram: бот от @BotFather и твой chat id (docs/SETUP.md, шаг «Telegram-бот»)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Оценка вакансий моделью Claude — один из двух вариантов:
#   1) подписка Claude (Pro/Max): на своём компьютере достаточно залогиненного `claude`; на сервере без браузера —
#      долгоживущий токен: `claude setup-token` на компьютере → скопировать РУКАМИ (sk-ant-oat01-…, 108 символов)
CLAUDE_CODE_OAUTH_TOKEN=
#   2) API-ключ с console.anthropic.com (оплата за токены, ~1 цент за вакансию)
ANTHROPIC_API_KEY=

# Часовой пояс расписания на сервере и времени в сообщениях
JOBSEARCH_TZ=Europe/Amsterdam

# Adzuna (бесплатные ключи на https://developer.adzuna.com/): агрегатор досок основной страны
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# hiring.cafe (ночной deep-прогон): необязательный ключ Jina Reader для резервного транспорта, без него 20 запросов/мин
JINA_API_KEY=
# Резервный транспорт hiring.cafe через настоящий Chrome под Xvfb (только сервер): on — deploy поставит Chrome
HC_CHROME=off

# Подпись браузерного расширения автозаполнения для Firefox (extension/sign.sh), addons.mozilla.org → API Keys
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
